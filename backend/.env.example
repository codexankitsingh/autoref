# Database (Supabase / Render Postgres — use Session pooler URL)
DATABASE_URL=sqlite:///./autoref.db

# Render: set ENABLE_JOB_SCRAPER=false unless you install requirements-scraper.txt
ENABLE_JOB_SCRAPER=false

# Google Gemini API (https://aistudio.google.com/apikey)
GEMINI_API_KEY=your-gemini-api-key-here

# Fallback when Gemini is blocked (Groq free tier example):
AI_PROVIDER=auto
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.groq.com/openai/v1
OPENAI_MODEL=openai/gpt-oss-120b

# Gmail OAuth2
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/gmail/callback

# Google Sheets
GOOGLE_SHEETS_CREDENTIALS_PATH=./credentials.json

# App Settings
APP_SECRET_KEY=your-secret-key-change-this
FRONTEND_URL=http://localhost:3000

# JWT Authentication
JWT_SECRET_KEY=your-jwt-secret-key-change-this
ADMIN_EMAIL=your-email@gmail.com

# Data Engineering resume link
RESUME_LINK_DATA_ENGINEERING=https://drive.google.com/file/d/1Cji1HuzTh1SVnTcfYGzAJN-BTxnUQYmL/view?usp=drive_link
