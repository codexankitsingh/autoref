# Database
DATABASE_URL=sqlite:///./autoref.db

# Google Gemini API
GEMINI_API_KEY=your-gemini-api-key-here

# Gmail OAuth2
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/gmail/callback

# Google Sheets
GOOGLE_SHEETS_CREDENTIALS_PATH=./credentials.json

# App Settings
APP_SECRET_KEY=your-secret-key-change-this
FRONTEND_URL=http://localhost:3000

# JWT Authentication
JWT_SECRET_KEY=your-jwt-secret-key-change-this
ADMIN_EMAIL=your-email@gmail.com

# Resume links (optional overrides)
RESUME_LINK_DATA_ENGINEERING=https://drive.google.com/file/d/1Cji1HuzTh1SVnTcfYGzAJN-BTxnUQYmL/view?usp=drive_link
RESUME_LINK_BACKEND_SDE=https://drive.google.com/file/d/1J1pLwgjVvm0VnI2Dd3CM5_66snSCk3uv/view?usp=sharing
RESUME_LINK_FINTECH=https://drive.google.com/file/d/1CXlPUQJgoJ_STt8eWmTpvj_FVbyv9ZhK/view?usp=sharing
