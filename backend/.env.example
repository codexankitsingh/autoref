# Database (Supabase / Render Postgres — use Session pooler URL)
DATABASE_URL=sqlite:///./autoref.db

# Render: set ENABLE_JOB_SCRAPER=false unless you install requirements-scraper.txt
ENABLE_JOB_SCRAPER=false

# Google Gemini API (https://aistudio.google.com/apikey)
GEMINI_API_KEY=your-gemini-api-key-here

# If Gemini returns 403 PERMISSION_DENIED, use OpenAI (or OpenRouter) fallback:
# AI_PROVIDER=auto
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini
# For OpenRouter: OPENAI_BASE_URL=https://openrouter.ai/api/v1
AI_PROVIDER=auto
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Gmail OAuth2
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/gmail/callback

# Google Sheets
GOOGLE_SHEETS_CREDENTIALS_PATH=./credentials.json

# App Settings
APP_SECRET_KEY=your-secret-key-change-this
FRONTEND_URL=http://localhost:3000

# JWT Authentication
JWT_SECRET_KEY=your-jwt-secret-key-change-this
ADMIN_EMAIL=your-email@gmail.com

# Resume links (optional overrides)
RESUME_LINK_DATA_ENGINEERING=https://drive.google.com/file/d/1Cji1HuzTh1SVnTcfYGzAJN-BTxnUQYmL/view?usp=drive_link
RESUME_LINK_BACKEND_SDE=https://drive.google.com/file/d/1J1pLwgjVvm0VnI2Dd3CM5_66snSCk3uv/view?usp=sharing
RESUME_LINK_FINTECH=https://drive.google.com/file/d/1CXlPUQJgoJ_STt8eWmTpvj_FVbyv9ZhK/view?usp=sharing
RESUME_LINK_SYSTEMS=https://drive.google.com/file/d/1K61zy3JA7inlXdAZ6aaZD8ETl61qJ38u/view?usp=sharing

